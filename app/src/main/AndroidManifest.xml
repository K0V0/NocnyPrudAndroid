<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- notifications about the low tariff starting / ending (runtime permission since API 33) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
        The notification has to land at a given minute, which only an exact alarm can do -
        WorkManager deliberately batches work into Doze maintenance windows.
        Since API 31 the user may revoke this, so it is always checked at runtime.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- alarms do not survive a reboot, they have to be armed again -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
            android:name=".MainApplication"
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.NocnyPrud2"
            tools:targetApi="31">

        <!-- first run flow-->

        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:label="@string/app_name"
                android:theme="@style/Theme.NocnyPrud2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
                android:name=".ui.activities.wizard.WelcomeActivity"
                android:label="@string/app_name"
                android:theme="@style/Theme.NocnyPrud2">
        </activity>

        <activity
                android:name=".ui.activities.wizard.CountrySelectActivity"
                android:label="@string/app_name"
                android:theme="@style/Theme.NocnyPrud2">
        </activity>

        <activity
                android:name=".ui.activities.wizard.ProviderSelectActivity"
                android:label="@string/app_name"
                android:theme="@style/Theme.NocnyPrud2">
        </activity>

        <activity
                android:name=".ui.activities.wizard.ServicePointSetupActivity"
                android:label="@string/app_name"
                android:theme="@style/Theme.NocnyPrud2">
        </activity>

        <activity
                android:name=".ui.activities.wizard.CezEanLookupActivity"
                android:label="@string/app_name"
                android:theme="@style/Theme.NocnyPrud2">
        </activity>

        <activity
                android:name=".ui.activities.wizard.PermissionsActivity"
                android:label="@string/app_name"
                android:theme="@style/Theme.NocnyPrud2">
        </activity>

        <activity
                android:name=".ui.activities.timetable.TimetableActivity"
                android:label="@string/app_name"
                android:theme="@style/Theme.NocnyPrud2">
        </activity>

        <!-- background work -->

        <receiver
                android:name=".backend.alarms.TariffAlarmReceiver"
                android:exported="false"/>

        <receiver
                android:name=".backend.receivers.BootReceiver"
                android:enabled="true"
                android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <!-- some vendors send this instead after an app update -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

    </application>

</manifest>
