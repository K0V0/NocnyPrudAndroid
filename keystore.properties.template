# Template for keystore.properties, which carries the release signing credentials.
#
# Copy this file to keystore.properties (that name is gitignored) and fill in your own values.
# Without it the project still builds - the release APK just comes out unsigned.
#
# To create a keystore:
#
#   keytool -genkeypair -v \
#     -keystore nocnyprud-release.jks \
#     -alias nocnyprud \
#     -keyalg RSA -keysize 4096 \
#     -validity 10950 \
#     -dname "CN=your name, OU=NocnyPrud, O=space.kovo, L=, ST=, C=SK"
#
# Keep the .jks file and this file backed up somewhere safe and out of the repository. Android
# identifies an app by its signing key, so losing the key means no further updates of this app
# can ever be installed over an existing one.

# path to the keystore, relative to the project root
storeFile=nocnyprud-release.jks
storePassword=
keyAlias=nocnyprud
keyPassword=
